OWNER_ALERT_INGEST_TOKEN=REPLACE_ME_WITH_URLSAFE_RANDOM_43_PLUS_CHARS
TELEGRAM_BOT_TOKEN=YOUR_BOTFATHER_TOKEN
TELEGRAM_OWNER_CHAT_ID=YOUR_PRIVATE_CHANNEL_ID
