# Reminders service configuration (copy to .env for local dev; set in Railway for prod)
DB_PATH=reminders.db
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM=dinnertime@kooexperience.com
ALERT_EXPORT_TOKEN=YOUR_EXPORT_TOKEN
ABUSE_HASH_SALT=YOUR_RANDOM_ABUSE_HASH_SALT
ALLOWED_ORIGIN=https://amex-explorer.kooexperience.com
PUBLIC_BASE_URL=http://localhost:8000
CONFIRM_TOKEN_EXPIRY_HOURS=168
TRUSTED_PROXY_HOPS=1
SUBSCRIBE_IP_LIMIT=5
SUBSCRIBE_EMAIL_LIMIT=5
SUBSCRIBE_GLOBAL_LIMIT=200
TABLE_DATA_URL=https://amex-explorer.kooexperience.com/data/table-for-two.json
OWNER_ALERTS_ENABLED=false
OWNER_ALERT_INGEST_TOKEN=REPLACE_ME_WITH_OWNER_INGEST_RANDOM_43_PLUS_CHARS
TELEGRAM_BOT_TOKEN=YOUR_BOTFATHER_TOKEN
TELEGRAM_OWNER_CHAT_ID=YOUR_PRIVATE_CHANNEL_ID
EXPLORER_BASE_URL=https://amex-explorer.kooexperience.com
OWNER_ALERT_NOT_BEFORE=
TELEGRAM_GUIDE_ENABLED=false
TELEGRAM_GUIDE_BOT_TOKEN=REPLACE_WITH_A_SEPARATE_BOTFATHER_TOKEN
TELEGRAM_GUIDE_WEBHOOK_SECRET=REPLACE_ME_WITH_GUIDE_WEBHOOK_RANDOM_43_PLUS_CHARS
TELEGRAM_IDENTITY_HASH_SALT=REPLACE_ME_WITH_IDENTITY_SALT_RANDOM_43_PLUS_CHARS
TELEGRAM_USER_LIMIT_PER_MINUTE=8
TELEGRAM_GLOBAL_LIMIT_PER_MINUTE=120
TELEGRAM_USER_LIMIT_PER_DAY=200
TELEGRAM_GLOBAL_LIMIT_PER_DAY=5000
TELEGRAM_REMINDERS_ENABLED=false
TELEGRAM_REMINDER_DISPATCH_TOKEN=REPLACE_ME_WITH_REMINDER_DISPATCH_RANDOM_43_PLUS_CHARS
